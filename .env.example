# Copy to .env and fill in. NEVER commit .env.

# gemini = production (Router + Generator over Gemini)   |   rules = deterministic offline engine, no key needed
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Router = small/fast model (strict JSON: intent + entities). Generator = larger model (phrases the verified draft).
# First model = preferred; the rest are the fallback chain. Rename here if Google renames a model (no code change).
ROUTER_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite
GENERATOR_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-2.5-flash
# false = Router only; replies come straight from the verified templates (cheapest, fully deterministic)
GENERATOR_ENABLED=true
ROUTER_TEMPERATURE=0
GENERATOR_TEMPERATURE=0.3

GEMINI_TIMEOUT_SECONDS=12
GEMINI_TOTAL_TIMEOUT_SECONDS=25
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY_SECONDS=3
GEMINI_COOLDOWN_SECONDS=60

# Shared secret the NestJS backend sends as header X-Internal-Token. Set it before exposing the service.
AI_SERVICE_TOKEN=
# Mock-data playground (/v1/dev/*). Keep false everywhere except your laptop.
ENABLE_DEV_ENDPOINTS=false
# If the Router fails on every model: true = answer with the rule router, false = HTTP 503 (backend retries)
AI_FALLBACK_TO_RULES=true
MIN_CONFIDENCE=0.4
LOG_LEVEL=INFO
