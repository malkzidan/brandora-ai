# Public configuration examples only. Never copy real secrets into this file.
# Canonical release: python -m app.server. Explicit staging settings are required.
APP_ENV=local
AI_INTEGRATION_ENABLED=false
SUPPLIED_CONTEXT_COMPAT_ENABLED=false
PRODUCTS_INTEGRATION_ENABLED=false
LEGACY_API_ENABLED=false
ENABLE_DEV_ENDPOINTS=false
AI_SERVICE_TOKEN=
BACKEND_BASE_URL=
BACKEND_SERVICE_TOKEN=
# Backend PUBLIC RS256 verification PEM; literal \n newlines supported.
BACKEND_CONTEXT_PUBLIC_KEY=
BACKEND_TIMEOUT_SECONDS=5
INTEGRATION_TIMEOUT_SECONDS=25
# Verified immediate proxy IPs/CIDRs only. Blank trusts no forwarded headers.
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=INFO

# Active canonical provider: GroqCloud only, then deterministic Python.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b
CHAT_PROVIDER_TIMEOUT_SECONDS=6
CHAT_TOTAL_TIMEOUT_SECONDS=12
CHAT_CIRCUIT_SECONDS=30

# Legacy main:app/CLI compatibility only. Not the Railway release path.
AI_PROVIDER=rules
AI_FALLBACK_TO_RULES=true
MIN_CONFIDENCE=0.4
GENERATOR_ENABLED=true
ROUTER_TEMPERATURE=0
GENERATOR_TEMPERATURE=0.3
GEMINI_API_KEY=
ROUTER_MODELS=gemini-3.5-flash-lite
GENERATOR_MODELS=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12
GEMINI_TOTAL_TIMEOUT_SECONDS=25
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY_SECONDS=3
GEMINI_COOLDOWN_SECONDS=60
# Optional historical CLI provider support; never used by canonical HTTP.
CHAT_PROVIDER_ORDER=groq
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free

# Explicit local developer adapter only; never used by the release service.
# Optional operator-approved business UUID allowlist for exact stock disclosure.
# Empty denies disclosure; a customer must also explicitly ask for a count.
STOCK_QUANTITY_DISCLOSURE_BUSINESSES=
DEV_BACKEND_URL=http://127.0.0.1:3000
DEV_BACKEND_OWNER_TOKEN=
DEV_BACKEND_BUSINESS_ID=
DEV_BACKEND_REVISION=83a65e9fc1f3f6994a7d115d6b83d86d3dd4d08b
