# --- Gemini ---
GEMINI_API_KEY=put-your-key-here
# Fallback chain, in order (comma separated). Edit to model IDs your key can access.
GEMINI_MODEL_CHAIN=gemini-3.5-flash,gemini-flash-latest,gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_TIMEOUT_SECONDS=30

# --- Service security (set the same value in the NestJS backend) ---
AI_SERVICE_KEY=

# --- Resilience (Feature 9) ---
RATE_LIMIT_WAIT_SECONDS=3
MAX_RATE_LIMIT_RETRIES=2
MAX_NETWORK_RETRIES=3
NETWORK_BACKOFF_BASE_SECONDS=1

# --- Throttling (Feature 1) ---
THROTTLE_MAX_MESSAGES=10
THROTTLE_WINDOW_SECONDS=60

# --- Behaviour ---
REVIEW_CONFIDENCE_THRESHOLD=0.7
CATALOG_TOP_K=25
HISTORY_LIMIT=10
