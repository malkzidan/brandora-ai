{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "reply", "requiresReview", "orderCandidate"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["INQUIRY", "PURCHASE_INTENT", "CONFIRMED_ORDER", "OTHER"]
    },
    "reply": { "type": "string", "minLength": 1 },
    "requiresReview": { "type": "boolean" },
    "orderCandidate": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/orderCandidate" }
      ]
    }
  },
  "$defs": {
    "orderCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceMessageId", "confidence", "reviewReasons", "items"],
      "properties": {
        "sourceMessageId": { "type": "string", "format": "uuid" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "LOW_ITEM_CONFIDENCE",
              "UNMATCHED_ITEM",
              "VARIANT_UNCLEAR",
              "OUT_OF_STOCK_RISK",
              "AMBIGUOUS_QUANTITY",
              "OTHER"
            ]
          }
        },
        "notes": { "type": ["string", "null"], "maxLength": 1000 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/orderCandidateItem" }
        }
      }
    },
    "orderCandidateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogItemId", "rawText", "quantity", "confidence"],
      "properties": {
        "catalogItemId": { "type": ["string", "null"], "format": "uuid" },
        "variantId": { "type": ["string", "null"], "format": "uuid" },
        "rawText": { "type": "string", "minLength": 1, "maxLength": 300 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
        "selectedAttributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "notes": { "type": ["string", "null"], "maxLength": 500 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
